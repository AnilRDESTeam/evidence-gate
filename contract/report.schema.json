{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-gate.local/contract/report.schema.json",
  "title": "Evidence Gate report",
  "description": "out/report.json: the source for the terminal, markdown and HTML reports.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "title", "type", "commit", "base", "run_id", "timestamp", "challenger", "criteria", "questions", "changed_files", "uncovered_files", "verdict", "exit_code", "route", "route_reason", "next_action", "context", "warnings", "contract_version"],
  "properties": {
    "task": { "type": "string", "description": "Task ID." },
    "title": { "type": "string", "description": "Task title." },
    "type": { "enum": ["new", "updated"], "description": "Task type." },
    "commit": { "type": "string", "description": "Git commit that was checked." },
    "base": { "type": "string", "description": "Base branch used for the diff, usually main." },
    "run_id": { "type": "string", "description": "ID of the Gate run." },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T", "description": "Time of the run (ISO 8601 date-time)." },
    "challenger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "model", "prompt_hash"],
      "description": "Which Challenger AI setup was used.",
      "properties": {
        "mode": { "enum": ["off", "saved", "live"], "description": "Challenger mode." },
        "model": { "type": ["string", "null"], "description": "Model name, or null when mode is off." },
        "prompt_hash": { "type": ["string", "null"], "description": "Short hash of the prompt, or null when mode is off." }
      }
    },
    "criteria": {
      "type": "array",
      "description": "One entry per criterion, with its label.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "statement", "label", "reason", "scenarios"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$", "description": "Criterion ID." },
          "priority": { "enum": ["MUST", "SHOULD"], "description": "MUST or SHOULD." },
          "statement": { "type": "string", "description": "The criterion text." },
          "label": { "enum": ["verified", "verified_waived", "not_verified", "needs_human_review"], "description": "The label given by the fixed rules in RULES.md." },
          "reason": {
            "enum": ["failed", "missing", "could_not_run", "unconfirmed", null],
            "description": "Why it is not verified. Required when label is not_verified; null otherwise."
          },
          "scenarios": { "type": "array", "items": { "type": "string" }, "description": "IDs of the scenarios run for this criterion." }
        },
        "if": { "properties": { "label": { "const": "not_verified" } }, "required": ["label"] },
        "then": { "properties": { "reason": { "type": "string" } } },
        "else": { "properties": { "reason": { "type": "null" } } }
      }
    },
    "questions": {
      "type": "array",
      "description": "Open questions that need a human decision.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]+$", "description": "Question ID." },
          "criterion": { "type": ["string", "null"], "pattern": "^AC-[0-9]+$", "description": "Related criterion, or null (shown as a '(new)' row)." },
          "text": { "type": "string", "description": "The question." }
        }
      }
    },
    "changed_files": { "type": "array", "items": { "type": "string" }, "description": "Changed files, after ignore_paths." },
    "uncovered_files": { "type": "array", "items": { "type": "string" }, "description": "Changed files no criterion covers." },
    "verdict": { "enum": ["READY", "BLOCKED", "NEEDS DECISION", "GATE ERROR"], "description": "The one answer for this change." },
    "exit_code": { "enum": [0, 1, 2, 3], "description": "0 READY, 1 BLOCKED, 2 NEEDS DECISION, 3 GATE ERROR." },
    "route": {
      "enum": ["back_to_developer", "product_owner_decides", "full_review", "focused_review", "light_review", null],
      "description": "How much human review is still needed. Null when the verdict is GATE ERROR."
    },
    "route_reason": { "type": "string", "description": "Why this route was chosen." },
    "next_action": { "type": "string", "description": "What to do next, in plain words." },
    "context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tests_passed", "tests_total"],
      "description": "Result of the existing tests (context only), or null if they were not run.",
      "properties": {
        "tests_passed": { "type": "integer", "minimum": 0, "description": "Tests that passed." },
        "tests_total": { "type": "integer", "minimum": 0, "description": "Tests that ran." }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" }, "description": "Warnings, for example SHOULD criteria not verified." },
    "contract_version": { "const": "1.0", "description": "Contract version this report follows." }
  },
  "allOf": [
    { "if": { "properties": { "verdict": { "const": "READY" } }, "required": ["verdict"] }, "then": { "properties": { "exit_code": { "const": 0 } } } },
    { "if": { "properties": { "verdict": { "const": "BLOCKED" } }, "required": ["verdict"] }, "then": { "properties": { "exit_code": { "const": 1 } } } },
    { "if": { "properties": { "verdict": { "const": "NEEDS DECISION" } }, "required": ["verdict"] }, "then": { "properties": { "exit_code": { "const": 2 } } } },
    { "if": { "properties": { "verdict": { "const": "GATE ERROR" } }, "required": ["verdict"] }, "then": { "properties": { "exit_code": { "const": 3 }, "route": { "type": "null" } } } }
  ]
}
